# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME

# Generate a unique random secret of at least 32 characters
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Comma-separated deployed frontend origins
CORS_ORIGINS=https://your-frontend-domain.example

# Optional: set only if Tesseract is not available on PATH
# TESSERACT_CMD=/usr/bin/tesseract
